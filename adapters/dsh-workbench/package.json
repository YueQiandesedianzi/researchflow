{
  "name": "@researchflow/dsh-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ResearchFlow workbench: live experiment-tree panel and standalone page backed by the rf CLI",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
